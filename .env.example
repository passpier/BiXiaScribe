# Embedding: local BAAI/bge-m3 via FlagEmbedding -- offline, no API key, no
# quota. Leave blank to auto-detect device (cpu/mps/cuda); set explicitly to
# force one.
EMBED_DEVICE=

# HuggingFace model id for the local embedding model. Leave blank for the
# default (BAAI/bge-m3, 1024-dim). Changing this changes the Chroma
# collection name (see embedding.py::CorpusEmbeddingFunction.name()), so an
# existing data/chroma/ needs scripts/build_index.py --reset after changing it.
LOCAL_EMBED_MODEL=

# Retrieval mode: "hybrid" (default, fuses BM25 keyword search with vector
# search via Reciprocal Rank Fusion -- helps wuxia proper nouns like 獨孤九劍)
# or "vector" (vector-only, the original behavior).
RETRIEVAL_MODE=hybrid

# Per-file character cap applied only to webnovel-*.txt corpus files (from
# scripts/prepare_webnovel.py), not to 金庸-*.txt novels. 0 disables the cap.
WEBNOVEL_MAX_CHARS=1000000

# Whether the 對話/scene_writer agent gets the wuxia_corpus_search tool at
# all -- distinct from RETRIEVAL_MODE above, which only controls *how* an
# already-enabled retrieval call is scored (hybrid vs vector-only).
# RETRIEVAL_ENABLED=false skips wiring the tool onto those two agents
# entirely, so a run needs neither a Chroma index nor the local embedding
# model. Also a real cost lever: retrieval is the largest token cost per
# CLAUDE.md's model-split A/B numbers (each tool call injects several
# ~1000-char corpus excerpts into the prompt, resent every subsequent
# turn) -- worth A/B'ing against a model with strong native wuxia register
# via eval/model_variants.json's Variant.use_retrieval or
# --no-retrieval on generate_script.py/eval_generation.py. Default true
# (today's only behavior).
RETRIEVAL_ENABLED=true

# --- 劇本生成（LLM / OpenRouter）---

# LLM backend: "openrouter" (default, real generation) or "fake" (offline
# canned responses, no key/network/cost -- used by tests/test_crew_pipeline.py).
LLM_BACKEND=openrouter

# Only used when LLM_BACKEND=openrouter. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by all three agents unless overridden per-agent below. Must be
# an OpenRouter model id prefixed "openrouter/" (litellm routing).
LLM_MODEL=openrouter/deepseek/deepseek-chat

# Optional per-agent overrides -- leave blank to fall back to LLM_MODEL.
# Each id must still carry the "openrouter/" litellm prefix; check the id
# still exists at https://openrouter.ai/models before setting it.
#
# 編劇 (writer): produces the event/branch skeleton (no dialogue) -- what
# matters is structural reliability and valid JSON, not prose quality, so a
# cheap model with solid reasoning/instruction-following is enough.
LLM_MODEL_WRITER=

# 對話 (dialogue): the one role worth spending more on -- Chinese prose
# quality here is most of what the final script "feels" like. IMPORTANT:
# whatever model you pick MUST support function calling/tool use, or it will
# never call wuxia_corpus_search and the RAG retrieval this whole pipeline
# is built around silently never fires -- this is easy to get wrong and
# hard to notice, since the pipeline still produces a valid script either
# way, just without any corpus-grounded wording.
LLM_MODEL_DIALOGUE=

# 校對 (proofreader): mechanical schema/cross-reference checking (also used
# for the repair pass in crew/pipeline.py when validate_references() finds
# problems) -- a cheap model that reliably emits well-formed JSON is enough.
LLM_MODEL_PROOF=

# Optional ceiling on a single LLM call's completion tokens, forwarded to
# crewai's LLM as max_tokens. Blank (default) passes nothing through --
# whatever the OpenRouter provider's own default max_completion_tokens is.
# Worth setting once SCRIPT_LENGTH=medium/long is in play: a longer target
# means longer Event JSON per scene, and a low provider-side default can
# silently truncate it before it becomes invalid JSON.
LLM_MAX_TOKENS=

# OpenRouter provider routing (https://openrouter.ai/docs/features/provider-routing).
# LLM_PROVIDER_ONLY pins to a comma-separated allowlist of provider slugs --
# needed when a model's cheapest/default route doesn't support tool calling,
# which would silently break wuxia_corpus_search the same way an unsupported
# dialogue model does (see LLM_MODEL_DIALOGUE's note above). Concretely: as
# of 2026-08-17, z-ai/glm-5.2's cheapest route (Novita) is fine, but
# tencent/hy3's cheapest route (GMICloud) reports tools=false -- pinning
# would be required to use hy3 safely. LLM_PROVIDER_SORT ("price" or
# "throughput") only takes effect when LLM_PROVIDER_ONLY is unset. Both
# blank (default) is today's behavior: OpenRouter's own default routing.
LLM_PROVIDER_ONLY=
LLM_PROVIDER_SORT=

# To A/B several per-agent splits at once instead of editing these one at a
# time, use `python scripts/eval_generation.py` -- it reads candidate splits
# from eval/model_variants.json (not from these env vars) and reports
# token spend, retrieval_calls, and structural metrics per variant, logged
# to out/generation_runs.jsonl. See CLAUDE.md's "Comparing per-agent model
# splits" section.

# --- 分層生成管線（layered）---

# "legacy" (default) uses the original single-shot 編劇->對話->校對 crew
# (crew/pipeline.py::run_pipeline_with_report()). "layered" is the
# checkpointed, resumable, batch-confirmed alternative (recommended --
# crew/orchestrator.py::run_layered()); see CLAUDE.md's script-generation
# section. Default stays "legacy" so this is a zero-risk opt-in and a
# one-line rollback if "layered" ever misbehaves. Every entry point
# (generate_script.py, eval_generation.py, ui/app.py) also has its own
# --pipeline-mode / checkbox that overrides this for a single run without
# touching .env.
PIPELINE_MODE=legacy

# Where crew/orchestrator.py persists per-stage checkpoints for the layered
# pipeline (outline/beats/scene/causal-graph JSON, one subdirectory per
# run_id) -- gitignored. Defaults to <project root>/.bixia_state if unset.
BIXIA_STATE_DIR=

# How many scenes within one causal-independent batch (see
# crew/orchestrator.py::plan_batches()) run concurrently. 1 disables
# parallelism, generating one scene per call.
SCENE_CONCURRENCY=3

# Token budget for the SessionDocument handed to each scene_writer call
# (character cards + prior scene summaries) -- see
# crew/context_builder.py::build_session_document(). Estimated via a
# dependency-free char-based heuristic, not a real tokenizer.
SESSION_DOC_MAX_TOKENS=4000

# Real-time causal consistency validation after each scene is generated
# (crew/causal.py). One of: off | warn | repair | strict. Default "repair"
# tries targeted repairs, then falls back to recording problems without
# blocking; "strict" refuses to checkpoint a scene that's still
# inconsistent after repair. See config.py for the full explanation.
CAUSAL_VALIDATION=repair

# Target script length -- a prompt-level knob only (see length.py), not an
# enforced cap. "short" (default, unchanged since before this knob existed)
# asks for 1-2 chapters x 1 beat (layered) / 2 events (legacy) -- today's
# floor, ~2-4 events per script in practice. "medium"/"long" ask for
# progressively more. Or use a custom spec:
# "custom:events=20,chapters=4,beats_per_chapter=5,min_dialogue=三段以上" --
# any subset of the four fields (missing ones are derived from events; e.g.
# "custom:events=20" alone is valid). Any unrecognized/malformed value falls
# back to "short". Every entry point also has its own override
# (--script-length on generate_script.py/eval_generation.py,
# Variant.script_length in eval/model_variants.json, the UI's 劇本篇幅
# selector) that takes precedence for a single run without touching this
# default.
SCRIPT_LENGTH=short
