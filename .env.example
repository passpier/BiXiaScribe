# Embedding backend: "bge-m3" (default, local, offline, no quota) or "gemini"
# (Google's API — subject to free-tier rate limits/daily quota).
EMBED_BACKEND=bge-m3

# Only used when EMBED_BACKEND=gemini.
GEMINI_API_KEY=

# Only used when EMBED_BACKEND=bge-m3. Leave blank to auto-detect
# (cpu/mps/cuda); set explicitly to force a device.
EMBED_DEVICE=

# --- Stage 2: CrewAI script generation ---

# LLM backend: "openrouter" (default, real generation) or "fake" (offline
# canned responses, no key/network/cost -- used by tests/test_crew_pipeline.py).
LLM_BACKEND=openrouter

# Only used when LLM_BACKEND=openrouter. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by all three agents unless overridden per-agent below. Must be
# an OpenRouter model id prefixed "openrouter/" (litellm routing).
LLM_MODEL=openrouter/deepseek/deepseek-chat

# Optional per-agent overrides -- e.g. a Chinese-prose-strong model for
# dialogue. Leave blank to fall back to LLM_MODEL.
LLM_MODEL_WRITER=
LLM_MODEL_DIALOGUE=
LLM_MODEL_PROOF=
